# Production environment for /opt/tutor-platform/.env (copy, fill in, chmod 600).
# Read both by docker compose (variable substitution) and by api/worker (env_file).
# DATABASE_URL, REDIS_URL, S3_ENDPOINT are set by docker-compose.prod.yml — do not add them here.

# --- Deployment (compose) ---
DOMAIN=tutor.example.com
ACME_EMAIL=admin@example.com
# Written by deploy.sh on every deploy; the tag of the running image (sha-<7 chars> or main)
IMAGE_TAG=main
# Override only for a fork; the default is the repository's GHCR package
# IMAGE_REPOSITORY=ghcr.io/classikteacher/teacher-app/backend

# --- Databases and storage (containers in the same compose) ---
# openssl rand -hex 24
POSTGRES_PASSWORD=
S3_ACCESS_KEY=tutor
# openssl rand -hex 24 (must not look like a placeholder: minioadmin / rustfsadmin / change-me are refused)
S3_SECRET_KEY=
S3_BUCKET_FILES=tutor-files

# --- Runtime ---
LOG_LEVEL=info
PLATFORM_TIMEZONE=Europe/Minsk
# Must be https and must match DOMAIN: used to register the Telegram webhooks and to build links
PUBLIC_BASE_URL=https://tutor.example.com
# Swagger is off in production unless explicitly enabled
SWAGGER_ENABLED=false

# --- Antivirus (optional, HW-05): leave empty to skip scanning (scan_status = skipped)
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Telegram bots (webhook mode in production) ---
TELEGRAM_MODE=webhook
# openssl rand -hex 32 ; characters A-Za-z0-9_- only
TELEGRAM_WEBHOOK_SECRET=
BOT_AUTH_TOKEN=
BOT_STAFF_TOKEN=
BOT_STUDENT_TOKEN=
BOT_PARENT_TOKEN=
# Usernames without @ (deep links t.me/<username>?start=...)
BOT_AUTH_USERNAME=
BOT_STAFF_USERNAME=
BOT_STUDENT_USERNAME=
BOT_PARENT_USERNAME=

# --- Security ---
# Telegram user ID of the first super admin (used by `docker compose run --rm seed-superadmin`)
BOOTSTRAP_SUPERADMIN_TELEGRAM_ID=
# sha256 hex of the system key for POST /api/v1/system/super-admin/transfer:
#   printf '%s' "$SYSTEM_KEY" | sha256sum | cut -d' ' -f1
SYSTEM_KEY_HASH=
# openssl rand -hex 32 (>= 32 characters)
JWT_SECRET=
