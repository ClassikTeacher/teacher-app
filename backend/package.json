{
  "name": "tutor-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Tutor Platform backend: REST API, four Telegram bots, workers",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.7.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "dev:api": "node --watch --import @swc-node/register/esm-register apps/api/src/main.ts",
    "dev:worker": "node --watch --import @swc-node/register/esm-register apps/worker/src/main.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "migrate": "node --import @swc-node/register/esm-register scripts/migrate.ts",
    "seed:superadmin": "node --import @swc-node/register/esm-register scripts/seed-superadmin.ts",
    "token:issue": "node --import @swc-node/register/esm-register scripts/issue-token.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/static": "^10.1.6",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/storage-redis": "^2.6.0",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "bullmq": "^6.3.17",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "file-type": "22",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.2.0",
    "@swc-node/core": "^1.15.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "testcontainers": "^11.14.0",
    "tsc-alias": "^1.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
