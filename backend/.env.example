# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug
# Platform default timezone (IANA) for new accounts
PLATFORM_TIMEZONE=Europe/Minsk
PLATFORM_LOCALE=ru

# --- HTTP API ---
API_HOST=0.0.0.0
API_PORT=3000
# Public base URL (used to register Telegram webhooks in production)
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgres://tutor:tutor@localhost:5432/tutor

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_FILES=tutor-files
S3_FORCE_PATH_STYLE=true

# --- Antivirus (HW-05): clamd host; leave empty to skip scanning (dev/test)
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Antivirus (HW-05): clamd host; leave empty to skip scanning (dev/test)
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Telegram bots ---
# Mode: polling (dev) | webhook (prod)
TELEGRAM_MODE=polling
# Secret for the X-Telegram-Bot-Api-Secret-Token header (webhook mode); 1-256 chars of A-Za-z0-9_-
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
BOT_AUTH_TOKEN=
BOT_STAFF_TOKEN=
BOT_STUDENT_TOKEN=
BOT_PARENT_TOKEN=
# Usernames without @ (used to build t.me deep links)
BOT_AUTH_USERNAME=TutorAuthDevBot
BOT_STAFF_USERNAME=TutorStaffDevBot
BOT_STUDENT_USERNAME=TutorStudentDevBot
BOT_PARENT_USERNAME=TutorParentDevBot

# --- Security ---
# Telegram user ID of the first super admin (used once by `pnpm seed:superadmin`)
BOOTSTRAP_SUPERADMIN_TELEGRAM_ID=
# sha256 hex of the system key used for POST /api/v1/system/super-admin/transfer
SYSTEM_KEY_HASH=
# HS256 secret for access tokens (>= 32 chars)
JWT_SECRET=change-me-change-me-change-me-change-me
# Pretty logs in dev (requires devDependencies); never in production
LOG_PRETTY=true
# Number of trusted reverse proxies (0 when the API is reached directly)
TRUST_PROXY_HOPS=0
# Swagger UI at /api/docs (default: enabled outside production)
SWAGGER_ENABLED=true
# Create the S3 bucket at startup (dev/test only; set false in production)
S3_AUTO_CREATE_BUCKET=true
